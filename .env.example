# ==============================================================================
# THERAPY SYSTEM - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Instructions:
# 1. Rename this file from ".env.example" to ".env"
# 2. Fill in the keys you need. (Most are optional if using local models).

# ------------------------------------------------------------------------------
# NEO4J DATABASE CREDENTIALS
# ------------------------------------------------------------------------------
# If running locally without Docker: bolt://localhost:7687
# If running the Python app inside Docker: bolt://neo4j:7687
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here
NEO4J_DATABASE=therapy

# ------------------------------------------------------------------------------
# OLLAMA CONFIGURATION (Local LLM)
# ------------------------------------------------------------------------------
# If running locally without Docker: http://127.0.0.1:11434
# If running the Python app inside Docker: http://host.docker.internal:11434
OLLAMA_HOST=http://127.0.0.1:11434

# ------------------------------------------------------------------------------
# API KEYS FOR CLOUD MODELS (Optional)
# Only required if you change BACKEND in app_integrated.py away from "ollama"
# ------------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_key_here
GEMINI_API_KEY=your_gemini_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here

# ------------------------------------------------------------------------------
# HUGGING FACE TOKEN (Optional)
# Only required if using gated models for the audio transcriber (Whisper)
# ------------------------------------------------------------------------------
HF_TOKEN=your_huggingface_token_here

# ------------------------------------------------------------------------------
# MISC
# ------------------------------------------------------------------------------
SESSION_LOG_DIR=./sessions

# Start-Mend.ps1 overrides (optional): Neo4j DBMS folder and the lab SSH login for gemma4:26b
# NEO4J_HOME=C:\Users\you\.Neo4jDesktop2\Data\dbmss\dbms-xxxx
# MEND_LAB=user@lab-host
# MEND_MODELS=legacy   # use the old 11-class emotion / 8-class behaviour models
